<?xml version="1.0" encoding="utf-8"?>
<!--
    glass_tile.xml
    Frosted glass card appearance — semi-transparent white overlay
    with a subtle ice-blue border for the detail info tiles (Row 1)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#1AFFFFFF" />

    <stroke
        android:width="1dp"
        android:color="#33A2D6F9" />

    <corners android:radius="16dp" />

</shape>